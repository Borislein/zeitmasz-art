---
import "../styles/global.css";
import type { Lang } from "../i18n/ui";

interface Props {
  title?: string;
  lang?: Lang;
}

const {
  title = "Zeitmasz — Label und Agentur für visionäre Künstler",
  lang = "de",
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Funnel+Display:wght@300..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
