---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import type { Lang } from "../../i18n/ui";
import type { Artist } from "../../data/artists";

interface Props {
  lang: Lang;
  artist: Artist;
}

const { lang, artist } = Astro.props;
const altHref = lang === "de" ? `/en/artists/${artist.slug}` : `/artists/${artist.slug}`;
---

<BaseLayout title={`${artist.name} — Zeitmasz`} lang={lang}>
  <Header lang={lang} altHref={altHref} />

  <section class="artist-detail">
    <h1>{artist.name}</h1>
    {artist.tagline && (
      <div class="tagline">
        <p>{artist.tagline[lang]}</p>
      </div>
    )}
  </section>

  <Footer lang={lang} />
</BaseLayout>
