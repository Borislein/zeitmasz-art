---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { releases } from "../../data/releases";
import { t, path, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const altHref = lang === "de" ? "/en" : "/";
---

<BaseLayout lang={lang}>
  <Header lang={lang} altHref={altHref} />

  <div class="hero">
    <h1>Zeitmasz</h1>
    <p>{t(lang, "hero.tagline")}</p>
  </div>

  <section class="rip">
    <p>
      {t(lang, "rip.text")}{" "}
      <a
        href="https://medium.com/@shfernandojr/sensational-a02f9d62af69"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t(lang, "rip.linkText")}
      </a>
    </p>
    <p>{t(lang, "rip.details")}</p>
  </section>

  <section class="newsletter" set:html={`
    <style type="text/css">@import url("https://assets.mlcdn.com/fonts.css?version=1787139");</style>
    <style type="text/css">
    .ml-form-embedContainer {
      box-sizing: border-box;
      display: table;
      margin: 0 auto;
      position: static;
      width: 100% !important;
    }
    .ml-form-embedContainer .ml-form-embedWrapper {
      background-color: transparent;
      border-width: 0px;
      border-color: transparent;
      border-radius: 4px;
      border-style: solid;
      box-sizing: border-box;
      display: inline-block !important;
      margin: 0;
      padding: 0;
      position: relative;
      width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedBody {
      padding: 20px 20px 0 20px;
    }
    .ml-form-embedContainer .ml-form-embedBody .ml-form-embedContent h4 {
      color: var(--clr-fg);
      font-family: var(--ff-heading);
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 10px 0;
      text-align: left;
    }
    .ml-form-embedContainer .ml-form-embedBody .ml-form-embedContent p {
      color: var(--clr-body-grey);
      font-family: var(--ff-body);
      font-size: 16px;
      font-weight: 400;
      line-height: 20px;
      margin: 0 0 20px 0;
      text-align: left;
    }
    .ml-form-embedContainer .ml-form-embedBody form .ml-form-formContent {
      margin: 0 0 20px 0;
      width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedBody form .ml-form-fieldRow {
      margin: 0 0 10px 0;
      width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedBody form input {
      background-color: var(--clr-bg) !important;
      color: var(--clr-fg) !important;
      border-color: var(--clr-border);
      border-radius: 4px !important;
      border-style: solid !important;
      border-width: 1px !important;
      font-family: var(--ff-body);
      font-size: 14px !important;
      padding: 10px 10px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .ml-form-embedContainer .ml-form-embedBody form input::placeholder {
      color: var(--clr-body-grey);
    }
    .ml-form-embedContainer .ml-form-embedBody .ml-form-embedSubmit button {
      background-color: var(--clr-fg) !important;
      border: 1px solid var(--clr-fg) !important;
      color: var(--clr-bg) !important;
      cursor: pointer;
      font-family: var(--ff-body);
      font-size: 14px !important;
      font-weight: 600 !important;
      padding: 10px !important;
      width: 100% !important;
      box-sizing: border-box !important;
      border-radius: 4px !important;
    }
    .ml-form-embedContainer .ml-form-embedBody .ml-form-embedSubmit button:hover {
      opacity: 0.8;
    }
    @media (max-width: 768px) {
      .ml-form-embedContainer .ml-form-embedBody .ml-form-embedContent h4 {
        font-size: 20px;
      }
    }
    </style>
    <div id="mlb2-45042848" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-45042848">
      <div class="ml-form-align-center">
        <div class="ml-form-embedWrapper embedForm">
          <div class="ml-form-embedBody ml-form-embedBodyHorizontal row-form">
            <div class="ml-form-embedContent">
              <h4>Newsletter</h4>
              <p>Melde dich für Updates an / Subscribe for news</p>
            </div>
            <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/1402895/forms/196339618632697754/subscribe" data-code="" method="post" target="_blank">
              <div class="ml-form-formContent horozintalForm">
                <div class="ml-form-horizontalRow">
                  <div class="ml-input-horizontal">
                    <div style="width: 100%;" class="horizontal-fields">
                      <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                        <input type="email" class="form-control" name="fields[email]" placeholder="Email" autocomplete="email" required>
                      </div>
                    </div>
                  </div>
                  <div class="ml-form-embedSubmit">
                    <button type="submit" class="primary">Subscribe</button>
                  </div>
                </div>
              </div>
              <input type="hidden" name="ml-submit" value="1">
              <input type="hidden" name="anticsrf" value="true">
            </form>
          </div>
          <div class="ml-form-successBody row-success" style="display: none">
            <div class="ml-form-successContent">
              <h4>Thank you!</h4>
              <p>You have successfully joined our subscriber list.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://groot.mailerlite.com/js/w/webforms.min.js" type="text/javascript"><\/script>
  `}></section>

  <section class="releases" id="katalog">
    <h2>{t(lang, "katalog.heading")}</h2>
    <div class="grid">
      {
        releases.map((release) => {
          const Tag = release.slug ? "a" : "div";
          const outlineLine = release.outlineLine ?? 1;
          return (
            <Tag
              class="card"
              href={release.slug ? path(lang, `/releases/${release.slug}`) : undefined}
            >
              <div class="cat-num">{release.catNum}</div>
              <h3>
                {release.title.split("\n").map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {i === outlineLine ? <span class="outline">{line}</span> : line}
                  </>
                ))}
              </h3>
              {release.info && <p>{release.info}</p>}
            </Tag>
          );
        })
      }
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
