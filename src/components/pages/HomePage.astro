---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import { releases } from "../../data/releases";
import { t, path, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const altHref = lang === "de" ? "/en" : "/";
---

<BaseLayout lang={lang}>
  <Header lang={lang} altHref={altHref} />

  <div class="hero">
    <h1>Zeitmasz</h1>
    <p>{t(lang, "hero.tagline")}</p>
  </div>

  <section class="rip">
    <p>
      {t(lang, "rip.text")}{" "}
      <a
        href="https://medium.com/@shfernandojr/sensational-a02f9d62af69"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t(lang, "rip.linkText")}
      </a>
    </p>
    <p>{t(lang, "rip.details")}</p>
  </section>

  <section style="padding: 28px 64px; max-width: 700px;">
    <div id="mlb2-45042848" class="ml-form-embedContainer">
      <form action="https://assets.mailerlite.com/jsonp/1402895/forms/196339618632697754/subscribe" method="post" target="_blank">
        <h4 style="font-family: var(--ff-heading); font-size: 20px; color: var(--clr-fg); margin: 0 0 20px 0;">Newsletter</h4>
        <div style="display: flex; gap: 10px;">
          <input type="email" name="fields[email]" placeholder="Email" required style="flex: 1; padding: 10px; border: 1px solid var(--clr-border); border-radius: 4px; background: var(--clr-bg); color: var(--clr-fg);">
          <button type="submit" style="padding: 10px 20px; border: 1px solid var(--clr-fg); border-radius: 4px; background: transparent; color: var(--clr-fg); cursor: pointer; font-weight: 600;">Subscribe</button>
        </div>
        <input type="hidden" name="ml-submit" value="1">
        <input type="hidden" name="anticsrf" value="true">
      </form>
    </div>
    <script src="https://groot.mailerlite.com/js/w/webforms.min.js" async></script>
  </section>

  <section class="releases" id="katalog">
    <h2>{t(lang, "katalog.heading")}</h2>
    <div class="grid">
      {
        releases.map((release) => {
          const Tag = release.slug ? "a" : "div";
          const outlineLine = release.outlineLine ?? 1;
          return (
            <Tag
              class="card"
              href={release.slug ? path(lang, `/releases/${release.slug}`) : undefined}
            >
              <div class="cat-num">{release.catNum}</div>
              <h3>
                {release.title.split("\n").map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {i === outlineLine ? <span class="outline">{line}</span> : line}
                  </>
                ))}
              </h3>
              {release.info && <p>{release.info}</p>}
            </Tag>
          );
        })
      }
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
